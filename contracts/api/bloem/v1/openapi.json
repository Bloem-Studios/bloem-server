          },
          {
            "description": "Verification proof for a PIN-locked profile, issued by POST /api/v2/profiles/{id}/verify-pin; required only when the declared profile is locked",
            "in": "header",
            "name": "X-Profile-Token",
            "schema": {
              "examples": [
                "pvt_5f3a9c1e7b2d4e8fa0c6"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
