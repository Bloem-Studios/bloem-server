{
  "components": {
    "schemas": {
      "BloemCapabilities": {
        "additionalProperties": false,
        "properties": {
          "api": {
            "description": "Identifier of the native surface this build serves.",
            "examples": [
              "bloem/v1"
            ],
            "type": "string"
          },
          "feature_tokens": {
            "description": "Versioned capability tokens a client matches against.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "features": {
            "$ref": "#/components/schemas/BloemCapabilityFeatures"
          },
          "identity_schema": {
            "description": "Version of the server/organization/account/profile identity model.",
            "format": "int64",
            "type": "integer"
          },
          "media_types": {
            "description": "The item types this build can serve.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "api",
          "identity_schema",
          "features",
          "media_types",
          "feature_tokens"
        ],
        "type": "object"
      },
      "BloemCapabilityFeatures": {
        "additionalProperties": false,
        "properties": {
          "delegated_admin_roles": {
            "description": "Administration can be delegated below the server owner.",
            "type": "boolean"
          },
          "direct_profile_login": {
            "description": "A profile can hold its own credentials rather than logging in through its account.",
            "type": "boolean"
          },
          "legacy_silo_v1": {
            "description": "This build still answers Silo's frozen /api/v1 surface.",
            "type": "boolean"
          },
          "organization_memberships": {
            "description": "Accounts can belong to organizations.",
            "type": "boolean"
          },
          "shared_device_pairing": {
            "description": "A device can be paired to a household rather than to one account.",
            "type": "boolean"
          },
          "tenant_bounded_media_scope": {
            "description": "Media visibility is bounded by the viewer's organization.",
            "type": "boolean"
          }
        },
        "required": [
          "legacy_silo_v1",
          "organization_memberships",
          "tenant_bounded_media_scope",
          "direct_profile_login",
          "shared_device_pairing",
          "delegated_admin_roles"
        ],
        "type": "object"
      },
      "CapabilityResponse": {
        "additionalProperties": false,
        "properties": {
          "allowed": {
            "type": "boolean"
          },
          "available": {
            "type": "boolean"
          },
          "heartbeat_interval_seconds": {
            "format": "int64",
            "type": "integer"
          },
          "supported": {
            "type": "boolean"
          }
        },
        "required": [
          "supported",
          "allowed",
          "available",
          "heartbeat_interval_seconds"
        ],
        "type": "object"
      },
      "ChannelResponse": {
        "additionalProperties": false,
        "properties": {
          "callsign": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "guide_station_id": {
            "type": "string"
          },
          "hd": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "logo_url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "number_override": {
            "type": "string"
          },
          "stream_url": {
            "type": "string"
          },
          "tuner_id": {
            "type": "string"
          }
        },
        "required": [
          "stream_url",
          "id",
          "tuner_id",
          "number",
          "callsign",
          "name",
          "logo_url",
          "hd",
          "enabled",
          "guide_station_id"
        ],
        "type": "object"
      },
      "ChannelsResponse": {
        "additionalProperties": false,
        "properties": {
          "channels": {
            "items": {
              "$ref": "#/components/schemas/ChannelResponse"
            },
            "type": "array"
          }
        },
        "required": [
          "channels"
        ],
        "type": "object"
      },
      "GuideResponse": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "format": "date-time",
            "type": "string"
          },
          "programs": {
            "items": {
              "$ref": "#/components/schemas/Program"
            },
            "type": "array"
          },
          "start": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "programs",
          "start",
          "end"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "Safe occurrence-specific explanation; not for control flow",
            "examples": [
              "The request did not pass validation; see errors."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Field-level validation details",
            "items": {
              "$ref": "#/components/schemas/ProblemError"
            },
            "type": "array"
          },
          "instance": {
            "description": "urn:silo:request:\u003crequest-id\u003e, matching the X-Request-ID response header",
            "examples": [
              "urn:silo:request:000000000000000000000003"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code, equal to the response status",
            "examples": [
              422
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "Short summary fixed for the problem type",
            "examples": [
              "Validation failed"
            ],
            "type": "string"
          },
          "type": {
            "description": "Stable problem type URI; the final segment is the problem identifier",
            "examples": [
              "https://siloserver.org/docs/api/v2/problems/validation_failed"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance"
        ],
        "type": "object"
      },
      "ProblemError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Stable machine-readable code for the failure",
            "examples": [
              "required"
            ],
            "type": "string"
          },
          "detail": {
            "description": "Safe human-readable explanation; never the rejected value",
            "examples": [
              "expected required property name to be present"
            ],
            "type": "string"
          },
          "location": {
            "description": "Where the error occurred: body.*, query.*, path.* or header.*",
            "examples": [
              "body.name"
            ],
            "type": "string"
          }
        },
        "required": [
          "location",
          "code",
          "detail"
        ],
        "type": "object"
      },
      "Program": {
        "additionalProperties": false,
        "properties": {
          "channel_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "episode": {
            "format": "int64",
            "type": "integer"
          },
          "external_id": {
            "type": "string"
          },
          "genres": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          },
          "is_live": {
            "type": "boolean"
          },
          "is_new": {
            "type": "boolean"
          },
          "season": {
            "format": "int64",
            "type": "integer"
          },
          "series_id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "start": {
            "format": "date-time",
            "type": "string"
          },
          "stop": {
            "format": "date-time",
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "channel_id",
          "series_id",
          "start",
          "stop",
          "title",
          "subtitle",
          "description",
          "genres",
          "image_url",
          "is_new",
          "is_live"
        ],
        "type": "object"
      },
      "SessionStartResponse": {
        "additionalProperties": false,
        "properties": {
          "hls_url": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "playback_ticket": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "stream_url": {
            "type": "string"
          },
          "transport": {
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "playback_ticket",
          "hls_url",
          "stream_url"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "description": "A session token or an API key in the Authorization header. The server decides which it holds.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Bloem's own surface: features Silo does not have and will not gain, plus the tenancy and entitlement model Bloem adds on top of it.",
    "title": "Bloem Native API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/bloem/v1/capabilities": {
      "get": {
        "operationId": "getBloemCapabilities",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BloemCapabilities"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "406": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Acceptable"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "What this build supports, for a client deciding which surfaces to use.",
        "tags": [
          "system"
        ],
        "x-silo-class": "public"
      }
    },
    "/api/bloem/v1/livetv/capability": {
      "get": {
        "operationId": "getBloemLiveTVCapability",
        "parameters": [
          {
            "description": "The household profile acting for this request; it must belong to the authenticated account.",
            "in": "header",
            "name": "X-Profile-Id",
            "required": true,
            "schema": {
              "examples": [
                "1"
              ],
              "type": "string"
