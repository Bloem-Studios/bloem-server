{
  "extends": "api/api-v1-devices.json",
  "rows": [
    {
      "listener": "api",
      "method": "PUT",
      "path": "/api/v1/devices/{device_id}/remote-control",
      "registration_index": 0,
      "not_applicable": {
        "pagination": "Single object response; nothing to page.",
        "filtering": "No filter parameters are read.",
        "raw_protocol": "Plain JSON request/response; no ranges, redirects, multipart, or upgrades."
      },
      "notes": "Retained Bloem v1 extension; no Silo v2 equivalent is declared. The executor installs a row-scoped synthetic fixture; original Silo fixtures and oracles stay unchanged. Native direct-profile credentials do not imply browser direct-profile login support.",
      "scenarios": [
        {
          "id": "bloem_device_remote.ok",
          "category": "status_headers",
          "description": "The profile advertises capabilities only for a device it registered.",
          "principal": {
            "class": "primary_profile"
          },
          "request": {
            "path": "/api/v1/devices/${device_a}/remote-control",
            "body": {
              "version": 1,
              "commands": [
                "pause",
                "seek"
              ]
            }
          },
          "expect": {
            "status": 200,
            "headers": [
              {
                "name": "Content-Type",
                "op": "equals",
                "value": "application/json"
              }
            ],
            "body": [
              {
                "pointer": "",
                "op": "equals",
                "value": {
                  "device_id": "${device_a}",
                  "version": 1,
                  "commands": [
                    "pause",
                    "seek"
                  ]
                }
              }
            ]
          },
          "requires": [
            "database"
          ],
          "fresh_state": true,
          "v2_expectation": null
        },
        {
          "id": "bloem_device_remote.meaning",
          "category": "data_meaning",
          "description": "Advertising again replaces the device capability version and complete command set.",
          "principal": {
            "class": "primary_profile"
          },
          "request": {
            "path": "/api/v1/devices/${device_a}/remote-control",
            "body": {
              "version": 1,
              "commands": [
                "pause",
                "seek"
              ]
            }
          },
          "expect": {
            "status": 200,
            "headers": [
              {
                "name": "Content-Type",
                "op": "equals",
                "value": "application/json"
              }
            ],
            "body": [
              {
                "pointer": "/version",
                "op": "equals",
                "value": 1
              },
              {
                "pointer": "/commands",
                "op": "equals",
                "value": [
                  "pause",
                  "seek"
                ]
              }
            ]
          },
          "requires": [
            "database"
          ],
          "fresh_state": true,
          "v2_expectation": null,
          "then": [
            {
              "method": "PUT",
              "request": {
                "path": "/api/v1/devices/${device_a}/remote-control",
                "body": {
                  "version": 2,
                  "commands": [
                    "seek"
                  ]
                }
              },
              "expect": {
                "status": 200,
                "body": [
                  {
                    "pointer": "",
                    "op": "equals",
                    "value": {
                      "device_id": "${device_a}",
                      "version": 2,
                      "commands": [
                        "seek"
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "bloem_device_remote.shape",
          "category": "field_presence_nullability",
          "description": "An explicit empty command array stays an array, with no account or profile identifiers in the response.",
          "principal": {
            "class": "primary_profile"
          },
          "request": {
            "path": "/api/v1/devices/${device_a}/remote-control",
            "body": {
              "version": 1,
              "commands": []
            }
          },
          "expect": {
            "status": 200,
            "headers": [
              {
                "name": "Content-Type",
                "op": "equals",
                "value": "application/json"
              }
            ],
            "body": [
              {
                "pointer": "",
                "op": "keys_equal",
                "value": [
                  "device_id",
                  "version",
                  "commands"
                ]
              },
              {
                "pointer": "/commands",
                "op": "equals",
                "value": []
              }
            ]
          },
          "requires": [
            "database"
          ],
          "fresh_state": true,
          "v2_expectation": null
        },
        {
          "id": "bloem_device_remote.sibling_device",
          "category": "authorization",
          "description": "A sibling profile device is not owned by the active profile.",
          "principal": {
            "class": "primary_profile"
          },
          "request": {
            "path": "/api/v1/devices/fixture-device-c/remote-control",
            "body": {
              "version": 1,
              "commands": [
                "pause",
                "seek"
              ]
            }
          },
          "expect": {
            "status": 404,
            "headers": [
              {
                "name": "Content-Type",
                "op": "equals",
                "value": "application/json"
              }
            ],
            "body": [
              {
                "pointer": "/error",
                "op": "equals",
                "value": "not_found"
              },
              {
                "pointer": "",
                "op": "keys_equal",
                "value": [
                  "error",
                  "message"
                ]
              },
              {
                "pointer": "/error",
                "op": "type",
                "value": "string"
              },
              {
                "pointer": "/message",
                "op": "type",
                "value": "string"
              },
              {
                "pointer": "/message",
                "op": "equals",
                "value": "Device not found"
              }
            ]
          },
          "requires": [
            "database"
          ],
          "v2_expectation": null
        },
        {
          "id": "bloem_device_remote.other_account_profile",
          "category": "authorization",
          "description": "A member bearer declaring a profile owned by another account (the admin's primary) is 404 not_found from viewer access: the profile lookup is scoped to the bearer's account, so a foreign profile is indistinguishable from an unknown one.",
          "principal": {
            "class": "profile",
            "profile": "admin_primary"
          },
          "request": {
            "path": "/api/v1/devices/${device_a}/remote-control",
            "body": {
              "version": 1,
              "commands": [
                "pause",
                "seek"
              ]
            }
          },
          "expect": {
            "status": 404,
            "headers": [
              {
                "name": "Content-Type",
                "op": "equals",
                "value": "application/json"
              }
            ],
            "body": [
              {
                "pointer": "/error",
                "op": "equals",
                "value": "not_found"
              },
              {
                "pointer": "",
                "op": "keys_equal",
                "value": [
                  "error",
                  "message"
                ]
              },
              {
                "pointer": "/error",
                "op": "type",
                "value": "string"
              },
              {
                "pointer": "/message",
                "op": "type",
                "value": "string"
              },
              {
                "pointer": "/message",
                "op": "equals",
                "value": "Profile not found"
              }
            ]
          },
          "notes": "Cross-account probe. The 404 (not 403) is the current scoped-lookup behavior; recorded as-is.",
          "v2_expectation": null
        },
        {
          "id": "bloem_device_remote.no_token",
          "category": "authorization",
          "description": "Without a bearer the auth middleware refuses the request before the handler runs.",
          "principal": {
            "class": "public"
          },
          "request": {
            "path": "/api/v1/devices/${device_a}/remote-control",
            "body": {
              "version": 1,
              "commands": [
                "pause",
                "seek"
              ]
            }
          },
          "expect": {
            "status": 401,
            "headers": [
              {
                "name": "Content-Type",
                "op": "equals",
                "value": "application/json"
              }
            ],
            "body": [
              {
                "pointer": "/error",
                "op": "equals",
                "value": "unauthorized"
              },
              {
                "pointer": "",
                "op": "keys_equal",
                "value": [
                  "error",
                  "message"
                ]
              },
              {
                "pointer": "/error",
                "op": "type",
                "value": "string"
              },
              {
                "pointer": "/message",
                "op": "type",
                "value": "string"
              },
              {
                "pointer": "/message",
                "op": "equals",
                "value": "Missing or malformed authorization header"
              }
            ]
          },
          "v2_expectation": null
        },
        {
          "id": "bloem_device_remote.no_profile",
          "category": "authorization",
          "description": "An account bearer still needs an active profile for device capability writes.",
          "principal": {
            "class": "authenticated"
          },
          "request": {
            "path": "/api/v1/devices/${device_a}/remote-control",
            "body": {
              "version": 1,
              "commands": [
                "pause",
                "seek"
              ]
            }
          },
          "expect": {
            "status": 400,
            "headers": [
              {
                "name": "Content-Type",
                "op": "equals",
                "value": "application/json"
              }
            ],
            "body": [
              {
                "pointer": "/error",
                "op": "equals",
                "value": "bad_request"
              },
              {
                "pointer": "",
                "op": "keys_equal",
                "value": [
                  "error",
                  "message"
                ]
              },
              {
                "pointer": "/error",
                "op": "type",
                "value": "string"
              },
              {
                "pointer": "/message",
                "op": "type",
                "value": "string"
              },
              {
                "pointer": "/message",
                "op": "equals",
                "value": "X-Profile-Id header is required"
              }
            ]
          },
          "requires": [
            "database"
          ],
          "v2_expectation": null
        },
        {
          "id": "bloem_device_remote.malformed",
          "category": "error",
          "description": "Malformed capability input is rejected.",
          "principal": {
            "class": "primary_profile"
          },
          "request": {
            "path": "/api/v1/devices/${device_a}/remote-control",
            "raw_body": "nope"
          },
          "expect": {
            "status": 400,
            "headers": [
              {
                "name": "Content-Type",
                "op": "equals",
                "value": "application/json"
              }
            ],
            "body": [
              {
                "pointer": "/error",
                "op": "equals",
                "value": "bad_request"
              },
              {
                "pointer": "",
                "op": "keys_equal",
                "value": [
                  "error",
                  "message"
                ]
              },
              {
                "pointer": "/error",
                "op": "type",
                "value": "string"
              },
              {
                "pointer": "/message",
                "op": "type",
                "value": "string"
              },
              {
                "pointer": "/message",
                "op": "equals",
                "value": "Invalid request body"
              }
            ]
          },
          "requires": [
            "database"
          ],
          "v2_expectation": null
        },
        {
          "id": "bloem_device_remote.unknown_command",
          "category": "error",
          "description": "Unknown command names cannot enter the capability registry.",
          "principal": {
            "class": "primary_profile"
          },
          "request": {
            "path": "/api/v1/devices/${device_a}/remote-control",
            "body": {
              "version": 1,
              "commands": [
                "reboot"
              ]
            }
          },
          "expect": {
            "status": 400,
            "headers": [
              {
                "name": "Content-Type",
                "op": "equals",
                "value": "application/json"
              }
            ],
            "body": [
              {
                "pointer": "/error",
                "op": "equals",
                "value": "unknown_command"
              },
              {
                "pointer": "",
                "op": "keys_equal",
                "value": [
                  "error",
                  "message"
                ]
              },
              {
                "pointer": "/error",
                "op": "type",
                "value": "string"
              },
              {
                "pointer": "/message",
                "op": "type",
                "value": "string"
              },
              {
                "pointer": "/message",
                "op": "equals",
                "value": "Unknown or non-session command name"
              }
            ]
          },
          "requires": [
            "database"
          ],
          "v2_expectation": null
        },
        {
          "id": "bloem_device_remote.sorted_deduplicated",
          "category": "sorting",
          "description": "A nonpositive version defaults to protocol version 1; commands are deduplicated and sorted before storage.",
          "principal": {
            "class": "primary_profile"
          },
          "request": {
            "path": "/api/v1/devices/${device_a}/remote-control",
            "body": {
              "commands": [
                "seek",
                "pause",
                "seek"
              ]
            }
          },
          "expect": {
            "status": 200,
            "headers": [
              {
                "name": "Content-Type",
                "op": "equals",
                "value": "application/json"
              }
            ],
            "body": [
              {
                "pointer": "/version",
                "op": "equals",
                "value": 1
              },
              {
                "pointer": "/commands",
                "op": "equals",
                "value": [
                  "pause",
                  "seek"
                ]
              }
            ]
          },
          "requires": [
            "database"
          ],
          "fresh_state": true,
          "v2_expectation": null
        }
      ]
    }
  ]
}
