        {
          "id": "bloem_profile_get.ok",
          "category": "status_headers",
          "description": "An account session reads one of its own profiles as JSON.",
          "principal": {
            "class": "primary_profile"
          },
          "request": {
            "path": "/api/v1/profiles/${profile_secondary}"
          },
          "expect": {
            "status": 200,
            "headers": [
              {
                "name": "Content-Type",
                "op": "equals",
                "value": "application/json"
              }
            ],
            "body": [
              {
                "pointer": "/id",
                "op": "equals",
                "value": "${profile_secondary}"
              }
            ]
          },
          "requires": [
            "database"
          ],
          "v2_expectation": null
        },
        {
          "id": "bloem_profile_get.meaning",
          "category": "data_meaning",
