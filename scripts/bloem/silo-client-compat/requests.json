{
 "POST /api/v2/auth/login": {
  "body": {
   "username": "compat-user",
   "password": "${user_password}"
  },
  "note": "a real sign-in, so the success body is compared, not only the refusal"
 },
 "POST /api/v2/auth/logout": {
  "phase": 3,
  "note": "ends the persona's session, so it runs last"
 },
 "DELETE /api/v2/profiles/{id}": {
  "phase": 3,
  "note": "removes the persona's own profile, so it runs last"
 },
 "POST /api/v2/account/password": {
  "phase": 3,
  "note": "a refused change; runs late in case it is accepted"
 },
 "POST /api/v2/profiles/{id}/verify-pin": {
  "body": {
   "pin": "${pin}"
  },
  "note": "the persona's profile with the right PIN for the PIN persona, a profile without one otherwise"
 },
 "POST /api/v2/diagnostics/reports": {
  "skip": "would file a diagnostics report with the hosted diagnostics service"
 },
 "POST /api/v2/diagnostics/reports/uploads": {
  "skip": "would start a hosted diagnostics upload"
 },
 "PUT /api/v2/diagnostics/reports/uploads/{upload_id}/chunks/{chunk_index}": {
  "skip": "part of a hosted diagnostics upload"
 },
 "POST /api/v2/diagnostics/reports/uploads/{upload_id}/complete": {
  "skip": "would send a hosted diagnostics upload"
 },
 "DELETE /api/v2/diagnostics/reports/uploads/{upload_id}": {
  "skip": "part of a hosted diagnostics upload"
 },
 "GET /api/v2/playback/capabilities": {
  "capture": {
   "installation_id": "installation_id"
  },
  "note": "playback writes need the installation id the capabilities name"
 },
 "POST /api/v2/playback/start": {
  "body": {
   "protocol_version": 3,
   "client_features": [
    "playback_plan_v3"
   ],
   "file_id": "${movie_file}",
   "profile_id": "${profile}",
   "playback_attempt_id": "attempt-compat-${persona}-0001",
   "quality_preference": "original",
   "subtitle_fidelity_preference": "compatible",
   "start_position": 0,
   "progress_persistence": "client",
   "audio_track_id": "file:${movie_file}:audio:0",
   "audio_track_index": 0,
   "metered": false,
   "client_capabilities": {
    "video_evidence": "exact",
    "audio_evidence": "exact",
    "codecs_video": [
     "h264"
    ],
    "codecs_video_hardware": [
     "h264"
    ],
    "codecs_audio": [
     "aac"
    ],
    "containers": [
     "mp4"
    ],
    "max_resolution": "1080p",
    "hdr": false,
    "video_decode": [
     {
      "codec": "h264",
      "profiles": [
       "high"
      ],
      "levels": [
       41
      ],
      "bit_depths": [
       8
      ],
      "max_width": 1920,
      "max_height": 1080,
      "max_frame_rate": 60,
      "max_bitrate_kbps": 20000,
      "hardware": true
     }
    ]
   },
   "client_playback_context": {
    "protocol_version": 3,
    "form_factor": "tv",
    "app_version": "3.0-test",
    "device": {
     "platform": "android",
     "os_version": "15",
     "manufacturer": "NVIDIA",
     "model": "SHIELD Android TV",
     "platform_details": {
      "abis": "arm64-v8a",
      "sdk_int": "35"
     }
    },
    "output": {
     "output_context_id": "7"
    },
    "deliveries": {
     "original_http": {
      "enabled": true,
      "supported_on_device": true,
      "containers": [
       "mp4"
      ],
      "video_codecs": [
       "h264"
      ],
      "audio_decode_codecs": [
       "aac"
      ],
      "audio_passthrough_codecs": [],
      "subtitles": {
       "embedded_text": true,
       "sidecar_text": true,
       "ass_styling": false,
       "embedded_bitmap": false,
       "sidecar_bitmap": false,
       "font_attachments": false
      },
      "features": [],
      "auth_header_refresh": true,
      "validated_claims": [],
      "transformations": []
     }
    }
   },
   "installation_id": "${installation_id}"
  },
  "capture": {
   "playback_session": "session_id",
   "stream_url": "playback_plan.stream.url"
  },
  "note": "Silo's protocol v3 start fixture (internal/playback/testdata) for the seeded MP4 movie, which plays directly",
  "followups": [
   {
    "op": "GET /api/v2/stream/{session_id}",
    "url": "${stream_url}",
    "headers": {
     "Range": "bytes=0-1023"
    },
    "note": "the plan's stream URL, read the way a player does: a byte range"
   },
   {
    "op": "HEAD /api/v2/stream/{session_id}",
    "method": "HEAD",
    "url": "${stream_url}",
    "auth": false,
    "note": "the stream token alone, without the app's sign-in headers"
   }
  ]
 },
 "POST /api/v2/playback/{session_id}/progress": {
  "body": {
   "installation_id": "${installation_id}",
   "sequence": 1,
   "position": 1.5,
   "is_paused": false
  }
 },
 "DELETE /api/v2/playback/{session_id}": {
  "body": {
   "installation_id": "${installation_id}",
   "stop_id": "${persona_uuid}"
  }
 },
 "POST /api/v2/collections": {
  "capture": {
   "collection": "id"
  }
 },
 "POST /api/v2/shuffles": {
  "capture": {
   "shuffle": "id"
  }
 },
 "PUT /api/v2/settings/values/{key}": {
  "query": {
   "scope": "profile"
  },
  "body": {
   "value": "never"
  }
 },
 "DELETE /api/v2/settings/values/{key}": {
  "query": {
   "scope": "profile"
  }
 },
 "POST /api/v2/playback/bandwidth-probe/results": {
  "phase": 2,
  "note": "a sampled result is a tiny bandwidth; recorded before playback/start it forces a transcode"
 },
 "POST /api/v2/events/ws-ticket": {
  "capture": {
   "ws_ticket": "ticket"
  },
  "followups": [
   {
    "op": "GET /api/v2/events/ws",
    "url": "/api/v2/events/ws",
    "websocket": [
     "silo.events.v2",
     "silo.ticket.${ws_ticket}"
    ],
    "note": "the events socket a Silo app opens with the ticket; compares the upgrade and the hello frame"
   }
  ]
 },
 "POST /api/v2/notifications/push/devices": {
  "headers": {
   "X-Push-Installation-Key": "c2lsby1jbGllbnQtY29tcGF0IHB1c2gga2V5IDAwMDE",
   "X-Push-Generation": "1"
  },
  "body": {
   "device_id": "compat-android-${persona}",
   "platform": "android",
   "token": "compat-fcm-token-${persona}-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
   "push_mode": "private_push"
  },
  "note": "a Silo Android app's ordered registration: an FCM token, the installation key and its first generation"
 },
 "POST /api/v2/devices/push/apple": {
  "headers": {
   "X-Push-Installation-Key": "c2lsby1jbGllbnQtY29tcGF0IHB1c2gga2V5IDAwMDE",
   "X-Push-Generation": "1"
  },
  "body": {
   "device_id": "compat-apple-${persona}",
   "apns_token": "${push_apns_token}",
   "apns_topic": "org.siloserver.silo",
   "apns_environment": "sandbox",
   "push_mode": "private_push"
  },
  "note": "a Silo iOS app's ordered registration with Silo's topic; seed() turns push delivery off, so nothing reaches a relay"
 }
}
